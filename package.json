{
  "name": "local-agent-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "harness": "./bin/harness.js"
  },
  "scripts": {
    "harness": "tsx src/cli.ts",
    "test": "vitest run",
    "test:live": "HARNESS_LIVE=1 vitest run test/live",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "diff": "^9.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/diff": "^8.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
